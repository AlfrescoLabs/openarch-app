# Every lifecycle command needs a setup folder.
! exec openarch-app up
stderr 'openarch-app has no openarch-app.yaml'
stderr 'Run .openarch app init. first, or use --dir.'
! exec openarch-app status --dir nowhere -o json
stdout '"code": "usage"'

# A setup with an unknown schema version is refused.
! exec openarch-app down --dir future
stderr 'schemaVersion 9, this build reads 2'

# logs cannot follow in JSON mode; the check runs before docker.
cd setup
! exec openarch-app logs --follow -o json
stdout '--follow does not work with --output json'

# A setup with Nuxeo needs nuxeo-deployment before compose runs. init fetched
# it, so a missing one gets the commands to fetch it again.
cd ../nuxeo
! exec openarch-app up
stderr 'Nuxeo needs .*nuxeo-deployment, which init fetched and is now missing'
stderr 'git -C .*nuxeo-deployment checkout --detach 0a5569054e6bb2763770d8ecd1d5c26f019fdc5d'

# A setup of 0.2.0 or earlier needs upgrade first.
cd ../v1
! exec openarch-app status
stderr 'schemaVersion 1, this build reads 2'
stderr 'openarch app upgrade'

-- future/openarch-app.yaml --
schemaVersion: 9
-- setup/openarch-app.yaml --
schemaVersion: 2
upstream: 1a0f58791dd550058507b3cd9f7bc390025e214a
alfresco: 1
nuxeo: 0
llmModel: ai/qwen2.5
embeddingModel: ai/mxbai-embed-large
bindIP: 127.0.0.1
context: app
-- nuxeo/openarch-app.yaml --
schemaVersion: 2
managedNuxeo: true
upstream: 1a0f58791dd550058507b3cd9f7bc390025e214a
alfresco: 1
nuxeo: 1
llmModel: ai/qwen2.5
embeddingModel: ai/mxbai-embed-large
bindIP: 127.0.0.1
context: app
-- v1/openarch-app.yaml --
schemaVersion: 1
upstream: 1a0f58791dd550058507b3cd9f7bc390025e214a
profile: full
llmModel: ai/qwen2.5
embeddingModel: ai/mxbai-embed-large
bindIP: 127.0.0.1
context: app
