# Usage errors stop init before it writes anything.
! exec openarch-app init --alfresco 3
stderr 'at most 2 Alfresco instances'
! exists openarch-app

! exec openarch-app init --alfresco 0
stderr 'the setup has no source'
stderr 'Use --alfresco, --nuxeo or both'

! exec openarch-app init --nuxeo 2
stderr 'at most 1 Nuxeo instance'

# The deprecated --profile and --extra still work, with a notice, and cannot be
# mixed with the new flags.
! exec openarch-app init --profile nuxeo --extra alfresco-2
stderr 'Warning: --profile and --extra are deprecated and will be removed: use --alfresco and --nuxeo'
stderr 'the alfresco-2 extra needs the alfresco or full profile'
! exec openarch-app init --profile full --nuxeo 1
stderr '--profile and --extra cannot be combined with --alfresco and --nuxeo'

# --alfresco-name needs two Alfresco instances, and one name for each.
! exec openarch-app init --alfresco-name Branch
stderr '--alfresco-name needs --alfresco 2'
! exec openarch-app init --alfresco 2 --alfresco-name Branch
stderr '--alfresco-name given 1 times, want 2'
! exists openarch-app

# --filesystem needs readers, user names only, and an existing folder.
mkdir shared
! exec openarch-app init --filesystem shared
stderr '--filesystem needs --filesystem-reader or --filesystem-everyone'
! exec openarch-app init --filesystem shared --filesystem-reader GROUP_Sales
stderr '--filesystem-reader GROUP_Sales is a group'
stderr 'Name each user instead'
! exec openarch-app init --filesystem shared --filesystem-reader jim --filesystem-everyone
stderr 'cannot be combined'
! exec openarch-app init --filesystem-reader jim
stderr 'need --filesystem'
! exec openarch-app init --filesystem missing --filesystem-everyone
stderr '--filesystem missing is not a folder'
! exec openarch-app init --alfresco 2 --sample-ui --filesystem shared --filesystem-reader jim
stderr '--filesystem does not work with --alfresco 2 --sample-ui'
! exists openarch-app

! exec openarch-app init --bind-ip localhost
stderr 'invalid --bind-ip localhost'

! exec openarch-app init a b
stderr 'accepts at most 1 arg'

# A folder that is already a setup is refused.
! exec openarch-app init done -o json
stdout '"code": "usage"'
stdout 'is already a setup folder'

# An existing openarch context is refused unless --force, and nothing is written.
env FAKE_CONTEXT_EXISTS=1
! exec openarch-app init fresh
stderr 'the openarch context "app" already exists'
stderr 'Use --context-name with another name, or --force to replace it.'
! exists fresh

-- done/openarch-app.yaml --
schemaVersion: 1
